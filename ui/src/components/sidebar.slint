import { Theme } from "../theme.slint";

// nav tab: muc dieu huong tren sidebar
export component NavTab {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> has-indicator: false;
    out property <bool> has-hover: tab_area.has-hover;
    callback clicked();

    height: 42px;

    tab_area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 15px;
            padding-right: 16px;
            spacing: 10px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    colorize: root.has-indicator ? #ffffff : (root.active ? #c8c8c8 : #7a7a7a);
                    animate colorize {
                        duration: 150ms;
                        easing: ease-out;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.label;
                    color: root.has-indicator ? #ffffff : (root.active ? #d6d6d6 : #8e8e8e);
                    font-size: 14px;
                    font-weight: root.has-indicator ? 600 : (root.active ? 600 : 500);
                    vertical-alignment: center;
                    animate color {
                        duration: 150ms;
                        easing: ease-out;
                    }
                }
            }
        }
    }
}

// the mang xa hoi khong vien co hieu ung hover
export component SocialBadge inherits Rectangle {
    in property <image> icon;
    in property <image> watermark;
    in property <length> watermark-offset-x: 10px;
    in property <length> watermark-offset-y: 0px;
    in property <string> handle: "@versenilvis";
    callback clicked();

    height: 32px;
    background: transparent;

    badge_ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        Rectangle {
            clip: true;
            border-radius: 8px;
            background: badge_ta.pressed ? #0a080d : (badge_ta.has-hover ? #1c1824 : #120F17);
            animate background { duration: 150ms; }

            Image {
                x: badge_ta.mouse-x - self.width / 2;
                y: badge_ta.mouse-y - self.height / 2;
                width: 100px;
                height: 100px;
                opacity: badge_ta.has-hover ? 0.35 : 0.0;
                animate opacity { duration: 250ms; }
                source: @image-url("../../assets/icons/border-glow-mesh.svg");
            }

            Image {
                x: parent.width - self.width + root.watermark-offset-x;
                y: (parent.height - self.height) / 2 + root.watermark-offset-y;
                width: 64px;
                height: 64px;
                source: root.watermark;
                colorize: #ffffff14;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.icon;
                        width: 15px;
                        height: 15px;
                        colorize: #ffffff;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.handle;
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// thanh dieu huong sidebar voi active box truot muot ma
export component Sidebar inherits Rectangle {
    in-out property <int> selected-tab: 0;
    callback tab-selected(int);
    callback open-url(string);

    width: 210px;
    background: Theme.sidebar-bg;
    border-width: 0px;
    border-color: transparent;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        // banner hinh anh kem gradient lam mo phia duoi
        Rectangle {
            width: parent.width;
            height: 105px;
            clip: true;

            Image {
                source: @image-url("../../assets/banner_in_app.png");
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }

            Rectangle {
                width: parent.width;
                height: parent.height;
                background: @linear-gradient(180deg, #00000000 0%, #00000000 45%, #0000000e 50%, #00000033 56%, #00000064 62%, #0000009b 69%, #000000cd 77%, #000000f1 86%, #000000ff 94%, #000000ff 98%, Theme.sidebar-bg 100%);
            }

            // clak logo icon mau den goc tren trai banner
            Image {
                x: 8px;
                y: 8px;
                source: @image-url("../../assets/icons/clak-logo.svg");
                width: 18px;
                height: 18px;
                colorize: #000000;
            }
        }

        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 14px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 4px;
            vertical-stretch: 1;

            // vung chua cac tab kem hop active truot muot ma
            tabs_box := Rectangle {
                height: 5 * 42px;

                property <int> hovered-tab:
                    tab0.has-hover ? 0 :
                    tab1.has-hover ? 1 :
                    tab2.has-hover ? 2 :
                    tab3.has-hover ? 3 :
                    tab4.has-hover ? 4 : -1;

                property <int> indicator-tab: (hovered-tab >= 0) ? hovered-tab : root.selected-tab;

                // active indicator box di chuyen muot ma
                active_indicator := Rectangle {
                    x: 0px;
                    y: tabs_box.indicator-tab * 42px + 2px;
                    width: parent.width;
                    height: 38px;
                    border-radius: Theme.radius-sm;
                    background: Theme.tab-active-bg;

                    animate y {
                        duration: 180ms;
                        easing: ease-out;
                    }
                }

                VerticalLayout {
                    spacing: 0px;

                    tab0 := NavTab {
                        icon: @image-url("../../assets/icons/keyboard.svg");
                        label: "Chung";
                        active: root.selected-tab == 0;
                        has-indicator: tabs_box.indicator-tab == 0;
                        clicked => {
                            root.selected-tab = 0;
                            root.tab-selected(0);
                        }
                    }

                    tab1 := NavTab {
                        icon: @image-url("../../assets/icons/zap.svg");
                        label: "Gõ tắt";
                        active: root.selected-tab == 1;
                        has-indicator: tabs_box.indicator-tab == 1;
                        clicked => {
                            root.selected-tab = 1;
                            root.tab-selected(1);
                        }
                    }

                    tab2 := NavTab {
                        icon: @image-url("../../assets/icons/grid.svg");
                        label: "Ứng dụng";
                        active: root.selected-tab == 2;
                        has-indicator: tabs_box.indicator-tab == 2;
                        clicked => {
                            root.selected-tab = 2;
                            root.tab-selected(2);
                        }
                    }

                    tab3 := NavTab {
                        icon: @image-url("../../assets/icons/activity.svg");
                        label: "Chẩn đoán";
                        active: root.selected-tab == 3;
                        has-indicator: tabs_box.indicator-tab == 3;
                        clicked => {
                            root.selected-tab = 3;
                            root.tab-selected(3);
                        }
                    }

                    tab4 := NavTab {
                        icon: @image-url("../../assets/icons/info.svg");
                        label: "Giới thiệu";
                        active: root.selected-tab == 4;
                        has-indicator: tabs_box.indicator-tab == 4;
                        clicked => {
                            root.selected-tab = 4;
                            root.tab-selected(4);
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            // badges mang xa hoi dat gan nhau o day sidebar
            VerticalLayout {
                spacing: 5px;

                SocialBadge {
                    icon: @image-url("../../assets/icons/github.svg");
                    watermark: @image-url("../../assets/icons/github-watermark.svg");
                    watermark-offset-x: 10px;
                    watermark-offset-y: 3px;
                    clicked => { root.open-url("https://github.com/versenilvis"); }
                }

                SocialBadge {
                    icon: @image-url("../../assets/icons/x.svg");
                    watermark: @image-url("../../assets/icons/x-watermark.svg");
                    watermark-offset-x: 17px;
                    watermark-offset-y: 0px;
                    clicked => { root.open-url("https://x.com/versenilvis"); }
                }

                SocialBadge {
                    icon: @image-url("../../assets/icons/telegram.svg");
                    watermark: @image-url("../../assets/icons/telegram-watermark.svg");
                    watermark-offset-x: 12px;
                    watermark-offset-y: 2px;
                    clicked => { root.open-url("https://t.me/versenilvis"); }
                }
            }
        }
    }
}
