import { Theme } from "../theme.slint";

// nut bam ghost khong vien
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> destructive: false;
    in property <bool> is-wide: false;
    callback clicked();

    height: root.is-wide ? 34px : 28px;
    border-radius: 6px;
    background: ta.has-hover ? (root.destructive ? #c5585830 : #383838)
        : (root.destructive ? #c5585818 : #262626);

    animate background {
        duration: 120ms;
        easing: ease-out;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 1px;
        alignment: center;
        Text {
            text: root.text;
            color: root.destructive ? (ta.has-hover ? #e57c7c : #c55858)
                : (ta.has-hover ? #ffffff : #c0c0c0);
            font-size: root.is-wide ? 13px : 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
            animate color { duration: 120ms; }
        }
    }
}

// nut hanh dong chinh phu khong vien
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <bool> enabled: true;
    in property <bool> is-wide: false;
    callback clicked();

    height: root.is-wide ? 36px : 30px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? #1a1a1a : (
        root.destructive ? (btn_ta.has-hover ? #c5585830 : #c558581a)
        : (root.primary ? (btn_ta.has-hover ? #ffffff : #e6e6e6)
        : (btn_ta.has-hover ? #363636 : #282828)));

    animate background {
        duration: 120ms;
        easing: ease-out;
    }

    btn_ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if root.enabled { root.clicked(); } }
    }

    hl := HorizontalLayout {
        alignment: center;
        min-width: root.is-wide ? 68px : 56px;
        padding-left: root.is-wide ? 16px : 12px;
        padding-right: root.is-wide ? 16px : 12px;
        padding-top: 1px;

        Text {
            text: root.text;
            color: !root.enabled ? #505050 : (
                root.destructive ? (btn_ta.has-hover ? #e57c7c : #c55858)
                : (root.primary ? #000000 : (btn_ta.has-hover ? #ffffff : #d4d4d4)));
            font-size: root.is-wide ? 14px : 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
            animate color { duration: 120ms; }
        }
    }
}
