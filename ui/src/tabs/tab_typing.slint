import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, MacroItemData } from "../theme.slint";
import { Divider, SettingItem, SectionHeader } from "../components/controls.slint";
import { GhostButton } from "../components/buttons.slint";

// tab 1: quan ly go tat va tu dong sua van ban
export component TabTyping inherits VerticalLayout {
    in-out property <bool> double_space_period: false;
    in-out property <bool> auto_capitalize: false;
    in-out property <bool> short_w: false;
    in-out property <bool> bracket_brackets: false;
    in-out property <bool> macros_enabled: true;
    in-out property <[MacroItemData]> macro_items: [];
    in-out property <string> new_macro_trigger: "";
    in-out property <string> new_macro_replace: "";
    in-out property <bool> new_macro_tab_only: false;
    in property <bool> is-wide: false;
    callback changed();
    callback add_macro(string, string, bool);
    callback toggle_macro_tab(int);
    callback remove_macro(int);

    spacing: root.is-wide ? 8px : 4px;

    SectionHeader {
        title: "TỰ ĐỘNG";
        is-wide: root.is-wide;
    }

    SettingItem {
        title: "Gõ w thành ư";
        subtitle: "Phím w ra chữ ư ở đầu từ";
        is-wide: root.is-wide;
        checked <=> root.short_w;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Gõ [ ] { } thành ơ ư Ơ Ư";
        subtitle: "Gõ 2 lần ngoặc để trả lại ký tự gốc";
        is-wide: root.is-wide;
        checked <=> root.bracket_brackets;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Nhấn Space 2 lần chèn dấu chấm";
        subtitle: "Tự động thêm dấu chấm và một khoảng trắng";
        is-wide: root.is-wide;
        checked <=> root.double_space_period;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Tự động viết hoa đầu câu";
        subtitle: "Viết hoa chữ cái đầu tiên sau dấu chấm, chấm hỏi, chấm than";
        is-wide: root.is-wide;
        checked <=> root.auto_capitalize;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Bật tính năng gõ tắt (Macro)";
        subtitle: "Thay thế từ viết tắt thành cụm từ đầy đủ";
        is-wide: root.is-wide;
        checked <=> root.macros_enabled;
        toggled => { root.changed(); }
    }

    SectionHeader {
        title: "BẢNG GÕ TẮT";
        show-divider: true;
        is-wide: root.is-wide;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 8px;
        spacing: 10px;

        LineEdit {
            placeholder-text: "Từ tắt (vd: vn hoặc :gui khach:)";
            text <=> root.new_macro_trigger;
            width: 175px;
            enabled: root.macros_enabled;
        }

        LineEdit {
            placeholder-text: "Cụm từ thay thế (vd: Việt Nam)";
            text <=> root.new_macro_replace;
            horizontal-stretch: 1;
            enabled: root.macros_enabled;
        }

        Rectangle {
            width: 78px;
            height: 32px;
            border-radius: Theme.radius-sm;
            background: root.new_macro_tab_only ? #1f332c : (tab_opt_ta.has-hover ? #ffffff10 : #16161a);
            border-width: 1px;
            border-color: root.new_macro_tab_only ? #61ffca55 : #ffffff18;

            tab_opt_ta := TouchArea {
                enabled: root.macros_enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.new_macro_tab_only = !root.new_macro_tab_only;
                }
            }

            Text {
                text: root.new_macro_tab_only ? "Chỉ Tab" : "Space/Tab";
                color: root.new_macro_tab_only ? #61ffca : Theme.text-secondary;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        GhostButton {
            is-wide: root.is-wide;
            text: "Thêm";
            clicked => {
                if root.new_macro_trigger != "" && root.new_macro_replace != "" {
                    root.add_macro(root.new_macro_trigger, root.new_macro_replace, root.new_macro_tab_only);
                    root.new_macro_trigger = "";
                    root.new_macro_replace = "";
                    root.changed();
                }
            }
        }
    }

    // khung bang cuon doc doc lap keo dai xuong chan trang
    HorizontalLayout {
        vertical-stretch: 1;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 2px;
        padding-bottom: 2px;

        Rectangle {
            vertical-stretch: 1;
            min-height: root.is-wide ? 240px : 180px;
            background: #0d0d0f;
            border-radius: Theme.radius-sm;
            clip: true;

            if root.macro_items.length == 0: VerticalLayout {
                alignment: center;
                Text {
                    text: root.macros_enabled ? "Chưa có từ viết tắt nào trong bảng" : "Tính năng gõ tắt đang tắt";
                    color: Theme.text-faint;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            if root.macro_items.length > 0: ScrollView {
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    alignment: start;

                    for item[idx] in root.macro_items: Rectangle {
                        height: root.is-wide ? 44px : 38px;
                        background: macro_row_ta.has-hover ? #ffffff0a : transparent;
                        border-radius: 6px;

                        macro_row_ta := TouchArea { }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: center;

                                Text {
                                    text: item.trigger;
                                    color: #ffffff;
                                    font-weight: 600;
                                    font-size: root.is-wide ? 15px : 13px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "→";
                                    color: Theme.text-faint;
                                    font-size: root.is-wide ? 15px : 13px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: item.replace;
                                    color: Theme.text-secondary;
                                    font-size: root.is-wide ? 14px : 13px;
                                    font-weight: 400;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Rectangle {
                                    width: item.is_dynamic ? 82px : 74px;
                                    height: 24px;
                                    border-radius: 5px;
                                    background: item.is_dynamic ? #182924 : (item.tab_only ? #1f2433 : #1a1a1f);
                                    border-width: 1px;
                                    border-color: item.is_dynamic ? #61ffca44 : (item.tab_only ? #7aa2f744 : #ffffff18);

                                    row_tab_ta := TouchArea {
                                        enabled: !item.is_dynamic;
                                        mouse-cursor: item.is_dynamic ? default : pointer;
                                        clicked => {
                                            root.toggle_macro_tab(idx);
                                            root.changed();
                                        }
                                    }

                                    Text {
                                        text: item.is_dynamic ? "ĐỘNG · Tab" : (item.tab_only ? "Chỉ Tab" : "Space/Tab");
                                        color: item.is_dynamic ? #61ffca : (item.tab_only ? #7aa2f7 : Theme.text-secondary);
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if !item.is_builtin: VerticalLayout {
                                    alignment: center;
                                    GhostButton {
                                        is-wide: root.is-wide;
                                        text: "Xoá";
                                        destructive: true;
                                        clicked => {
                                            root.remove_macro(idx);
                                            root.changed();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
