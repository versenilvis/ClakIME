import { ScrollView, LineEdit, Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Divider, SettingItem, FieldRow, SegmentedSwitch, SectionHeader } from "../components/controls.slint";
import { GhostButton } from "../components/buttons.slint";

// tab 2: he thong va danh sach ung dung loai tru
export component TabAdvanced inherits VerticalLayout {
    in-out property <bool> autostart_system: true;
    in-out property <bool> remember_app_state: true;
    in-out property <[string]> excluded_apps: [];
    in-out property <string> new_app_name: "";
    in-out property <bool> uinput_ack: false;
    in-out property <bool> debug_log: false;
    in-out property <int> pacing_preset_index: 1;
    in-out property <int> draftjs_delay_ms: 16;
    in-out property <int> draftjs_gap_ms: 8;
    in-out property <int> terminal_delay_ms: 12;
    in-out property <int> terminal_gap_ms: 3;
    in property <bool> is-wide: false;
    callback changed();
    callback add_excluded_app(string);
    callback remove_excluded_app(int);

    spacing: root.is-wide ? 8px : 0px;

    SectionHeader {
        title: "HỆ THỐNG";
        show-divider: false;
        is-wide: root.is-wide;
    }

    SettingItem {
        title: "Khởi động cùng hệ thống";
        subtitle: "Tự động chạy bộ gõ Clak Tiếng Việt khi đăng nhập máy tính";
        is-wide: root.is-wide;
        checked <=> root.autostart_system;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Nhớ trạng thái theo từng ứng dụng";
        subtitle: "Tự khôi phục chế độ V/E khi chuyển qua lại giữa các ứng dụng";
        is-wide: root.is-wide;
        checked <=> root.remember_app_state;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Xác nhận (ACK) khi gửi phím uinput";
        subtitle: "Chờ kernel xác nhận để hạn chế race condition";
        is-wide: root.is-wide;
        checked <=> root.uinput_ack;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Ghi log vào /tmp/clak.log";
        subtitle: "Dùng khi cần chẩn đoán lỗi surrounding text / uinput";
        is-wide: root.is-wide;
        checked <=> root.debug_log;
        toggled => { root.changed(); }
    }

    SectionHeader {
        title: "TỐC ĐỘ PHÍM (PACING)";
        show-divider: true;
        is-wide: root.is-wide;
    }

    FieldRow {
        title: "Chế độ độ trễ";
        subtitle: "Điều chỉnh nhịp gõ uinput cho web và terminal";
        is-wide: root.is-wide;
        SegmentedSwitch {
            options: ["Nhanh", "Cân bằng", "An toàn", "Tùy biến"];
            current-index <=> root.pacing_preset_index;
            is-wide: root.is-wide;
            selected(idx) => {
                if idx == 0 {
                    root.draftjs_delay_ms = 10;
                    root.draftjs_gap_ms = 4;
                    root.terminal_delay_ms = 6;
                    root.terminal_gap_ms = 2;
                } else if idx == 1 {
                    root.draftjs_delay_ms = 16;
                    root.draftjs_gap_ms = 8;
                    root.terminal_delay_ms = 12;
                    root.terminal_gap_ms = 3;
                } else if idx == 2 {
                    root.draftjs_delay_ms = 24;
                    root.draftjs_gap_ms = 12;
                    root.terminal_delay_ms = 20;
                    root.terminal_gap_ms = 5;
                }
                root.changed();
            }
        }
    }

    if root.pacing_preset_index == 3: FieldRow {
        title: "Trễ Web / DraftJS (" + root.draftjs_delay_ms + " ms)";
        subtitle: "Thời gian chờ sau khi xóa ký tự trên React/DraftJS";
        is-wide: root.is-wide;
        Slider {
            width: root.is-wide ? 200px : 160px;
            minimum: 6;
            maximum: 40;
            value: root.draftjs_delay_ms;
            changed(val) => {
                root.draftjs_delay_ms = Math.round(val);
                root.changed();
            }
        }
    }

    if root.pacing_preset_index == 3: FieldRow {
        title: "Giãn cách Web (" + root.draftjs_gap_ms + " ms)";
        subtitle: "Khoảng nghỉ giữa các phím Backspace xóa liên tiếp";
        is-wide: root.is-wide;
        Slider {
            width: root.is-wide ? 200px : 160px;
            minimum: 2;
            maximum: 20;
            value: root.draftjs_gap_ms;
            changed(val) => {
                root.draftjs_gap_ms = Math.round(val);
                root.changed();
            }
        }
    }

    if root.pacing_preset_index == 3: FieldRow {
        title: "Trễ Terminal uinput (" + root.terminal_delay_ms + " ms)";
        subtitle: "Độ trễ xóa cho terminal non-VTE (Kitty/Alacritty/Foot)";
        is-wide: root.is-wide;
        Slider {
            width: root.is-wide ? 200px : 160px;
            minimum: 4;
            maximum: 30;
            value: root.terminal_delay_ms;
            changed(val) => {
                root.terminal_delay_ms = Math.round(val);
                root.changed();
            }
        }
    }

    if root.pacing_preset_index == 3: FieldRow {
        title: "Giãn cách Terminal (" + root.terminal_gap_ms + " ms)";
        subtitle: "Khoảng nghỉ giữa các phím xóa trong terminal uinput";
        is-wide: root.is-wide;
        Slider {
            width: root.is-wide ? 200px : 160px;
            minimum: 1;
            maximum: 10;
            value: root.terminal_gap_ms;
            changed(val) => {
                root.terminal_gap_ms = Math.round(val);
                root.changed();
            }
        }
    }

    SectionHeader {
        title: "LOẠI TRỪ";
        show-divider: true;
        is-wide: root.is-wide;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 8px;
        spacing: 10px;

        LineEdit {
            placeholder-text: "Nhập WM_CLASS app (vd: steam, code, alacritty)...";
            text <=> root.new_app_name;
            horizontal-stretch: 1;
        }

        GhostButton {
            is-wide: root.is-wide;
            text: "Thêm";
            clicked => {
                if root.new_app_name != "" {
                    root.add_excluded_app(root.new_app_name);
                    root.new_app_name = "";
                    root.changed();
                }
            }
        }
    }

    // khung bang cuon doc doc lap keo dai xuong chan trang
    HorizontalLayout {
        vertical-stretch: 1;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 2px;
        padding-bottom: 2px;

        Rectangle {
            vertical-stretch: 1;
            min-height: root.is-wide ? 240px : 160px;
            background: #0d0d0f;
            border-width: 0px;
            border-color: transparent;
            border-radius: Theme.radius-sm;
            clip: true;

            if root.excluded_apps.length == 0: VerticalLayout {
                alignment: center;
                Text {
                    text: "Chưa có ứng dụng nào trong danh sách loại trừ";
                    color: Theme.text-faint;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            if root.excluded_apps.length > 0: ScrollView {
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    alignment: start;

                    for app[idx] in root.excluded_apps: Rectangle {
                        height: root.is-wide ? 44px : 38px;
                        background: app_row_ta.has-hover ? #ffffff0a : transparent;
                        border-radius: 6px;

                        app_row_ta := TouchArea { }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: app;
                                    color: Theme.text-primary;
                                    font-size: root.is-wide ? 15px : 13px;
                                    font-weight: Theme.text-weight;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    is-wide: root.is-wide;
                                    text: "Xoá";
                                    destructive: true;
                                    clicked => {
                                        root.remove_excluded_app(idx);
                                        root.changed();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
