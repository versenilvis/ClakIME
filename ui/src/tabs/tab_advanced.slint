import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, AppRuleData } from "../theme.slint";
import { Divider, SettingItem, SectionHeader, Dropdown } from "../components/controls.slint";
import { GhostButton } from "../components/buttons.slint";

// tab 2: he thong va quy tac ung dung
export component TabAdvanced inherits VerticalLayout {
    in-out property <bool> autostart_system: true;
    in-out property <bool> remember_app_state: true;
    in-out property <[AppRuleData]> app_rules: [];
    in-out property <string> new_app_name: "";
    in-out property <int> new_app_mode_index: 0;
    in-out property <bool> uinput_ack: false;
    in-out property <bool> debug_log: false;
    in property <bool> is-wide: false;
    callback changed();
    callback add_app_rule(string, string);
    callback remove_app_rule(int);

    spacing: root.is-wide ? 8px : 0px;

    SectionHeader {
        title: "HỆ THỐNG";
        show-divider: false;
        is-wide: root.is-wide;
    }

    SettingItem {
        title: "Khởi động cùng hệ thống";
        subtitle: "Tự động chạy bộ gõ Clak Tiếng Việt khi đăng nhập máy tính";
        is-wide: root.is-wide;
        checked <=> root.autostart_system;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Nhớ trạng thái theo từng ứng dụng";
        subtitle: "Tự khôi phục chế độ V/E khi chuyển qua lại giữa các ứng dụng";
        is-wide: root.is-wide;
        checked <=> root.remember_app_state;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Xác nhận (ACK) khi gửi phím uinput";
        subtitle: "Chờ kernel xác nhận để hạn chế race condition";
        is-wide: root.is-wide;
        checked <=> root.uinput_ack;
        toggled => { root.changed(); }
    }

    SettingItem {
        title: "Ghi log vào /tmp/clak.log";
        subtitle: "Dùng khi cần chẩn đoán lỗi surrounding text / uinput";
        is-wide: root.is-wide;
        checked <=> root.debug_log;
        toggled => { root.changed(); }
    }

    SectionHeader {
        title: "CHẾ ĐỘ THEO ỨNG DỤNG";
        show-divider: true;
        is-wide: root.is-wide;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 8px;
        spacing: 10px;

        LineEdit {
            placeholder-text: "Nhập WM_CLASS app (vd: zen, libreoffice, steam)...";
            text <=> root.new_app_name;
            horizontal-stretch: 1;
        }

        Dropdown {
            width: 150px;
            model: ["Uinput", "Surrounding", "Tắt tiếng Việt"];
            current-index <=> root.new_app_mode_index;
        }

        GhostButton {
            is-wide: root.is-wide;
            text: "Thêm";
            clicked => {
                if root.new_app_name != "" {
                    root.add_app_rule(
                        root.new_app_name,
                        root.new_app_mode_index == 0 ? "uinput" : (root.new_app_mode_index == 1 ? "surrounding" : "off")
                    );
                    root.new_app_name = "";
                    root.changed();
                }
            }
        }
    }

    // khung bang cuon doc doc lap keo dai xuong chan trang
    HorizontalLayout {
        vertical-stretch: 1;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 2px;
        padding-bottom: 2px;

        Rectangle {
            vertical-stretch: 1;
            min-height: root.is-wide ? 240px : 160px;
            background: #0d0d0f;
            border-width: 0px;
            border-color: transparent;
            border-radius: Theme.radius-sm;
            clip: true;

            if root.app_rules.length == 0: VerticalLayout {
                alignment: center;
                Text {
                    text: "Chưa có quy tắc ứng dụng nào (tất cả đều chạy Tự động)";
                    color: Theme.text-faint;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            if root.app_rules.length > 0: ScrollView {
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    alignment: start;

                    for rule[idx] in root.app_rules: Rectangle {
                        height: root.is-wide ? 44px : 38px;
                        background: app_row_ta.has-hover ? #ffffff0a : transparent;
                        border-radius: 6px;

                        app_row_ta := TouchArea { }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: rule.name;
                                        color: Theme.text-primary;
                                        font-size: root.is-wide ? 15px : 13px;
                                        font-weight: Theme.text-weight;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        background: rule.mode == "uinput" ? #3b82f620 : (rule.mode == "surrounding" ? #10b98120 : #ef444420);
                                        border-radius: 4px;
                                        height: 22px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;
                                            Text {
                                                text: rule.mode == "uinput" ? "Uinput" : (rule.mode == "surrounding" ? "Surrounding" : "Tắt tiếng Việt");
                                                color: rule.mode == "uinput" ? #60a5fa : (rule.mode == "surrounding" ? #34d399 : #f87171);
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    is-wide: root.is-wide;
                                    text: "Xoá";
                                    destructive: true;
                                    clicked => {
                                        root.remove_app_rule(idx);
                                        root.changed();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
