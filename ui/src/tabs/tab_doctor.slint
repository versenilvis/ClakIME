import { Theme, DoctorLineData } from "../theme.slint";
import { Divider, SectionHeader } from "../components/controls.slint";
import { ActionButton, GhostButton } from "../components/buttons.slint";
import { ScrollView } from "std-widgets.slint";

// tab chan doan he thong phong cach terminal log
export component TabDoctor inherits VerticalLayout {
    in property <[DoctorLineData]> lines: [];
    in property <bool> has_scanned: false;
    in property <bool> is_scanning: false;
    in property <string> last_scanned: "";
    in property <string> summary_text: "";
    in property <bool> is_healthy: true;
    in property <bool> copied_toast: false;
    in property <int> score_level: 0;
    in property <string> score_text: "100";
    in property <string> score_label: "Khỏe mạnh";
    in property <color> score_color: #10b981;

    callback scan_requested();
    callback copy_requested();

    alignment: start;
    spacing: 12px;

    SectionHeader {
        title: "CHẨN ĐOÁN HỆ THỐNG";
        show-divider: false;
    }

    // thanh trang thai va cong cu tren dau tab
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                Text {
                    text: "Môi trường gõ phím";
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                if root.has_scanned: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        height: 24px;
                        border-radius: 12px;
                        background: root.score_color.with-alpha(0.12);
                        border-width: 1px;
                        border-color: root.score_color.with-alpha(0.35);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;

                                if root.score_level == 0: Image {
                                    source: @image-url("../../assets/icons/smile.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.score_color;
                                }
                                if root.score_level == 1: Image {
                                    source: @image-url("../../assets/icons/meh.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.score_color;
                                }
                                if root.score_level == 2: Image {
                                    source: @image-url("../../assets/icons/frown.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.score_color;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Text {
                                    text: root.score_text + "/100 · " + root.score_label;
                                    color: root.score_color;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: root.has_scanned ? ("Lần quét gần nhất: " + root.last_scanned) : "Chưa thực hiện chẩn đoán trong phiên làm việc này";
                color: Theme.text-muted;
                font-size: 12px;
                font-weight: Theme.text-weight;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                if root.has_scanned: ActionButton {
                    text: root.copied_toast ? "Đã sao chép!" : "Sao chép báo cáo";
                    enabled: !root.is_scanning;
                    clicked => { root.copy_requested(); }
                }

                ActionButton {
                    text: root.is_scanning ? "Đang quét..." : (root.has_scanned ? "Quét lại" : "Chẩn đoán ngay");
                    primary: true;
                    enabled: !root.is_scanning;
                    clicked => { root.scan_requested(); }
                }
            }
        }
    }

    // noi dung chinh: man hinh trong (khi chua scan)
    if !root.has_scanned && !root.is_scanning: Rectangle {
        height: 545px;
        background: #09090b;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: #18181b;

        VerticalLayout {
            alignment: center;
            spacing: 16px;
            padding-left: 40px;
            padding-right: 40px;

            HorizontalLayout {
                alignment: center;

                Image {
                    source: @image-url("../../assets/icons/activity.svg");
                    width: 48px;
                    height: 48px;
                    colorize: #3f3f46;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "Sẵn sàng chẩn đoán hệ thống";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Tự động kiểm tra quyền /dev/uinput, thiết bị chuột, Fcitx5 RAM inode, file cấu hình và phát hiện ứng dụng xung đột.";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: center;

                ActionButton {
                    text: "Bắt đầu chẩn đoán ngay";
                    primary: true;
                    clicked => { root.scan_requested(); }
                }
            }
        }
    }

    // noi dung console log khong can topbar macos
    if root.has_scanned || root.is_scanning: Rectangle {
        height: 545px;
        background: #08080a;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: #1c1c21;

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 14px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 4px;
                alignment: start;

                if root.is_scanning: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "> Đang truy vấn kernel và thông tin session...";
                        color: #60a5fa;
                        font-size: 13px;
                    }
                    Text {
                        text: "> Kiểm tra quyền hạn thiết bị /dev/uinput và /dev/input...";
                        color: #71717a;
                        font-size: 13px;
                    }
                    Text {
                        text: "> Phân tích bảng ánh xạ bộ nhớ /proc/*/maps của Fcitx5...";
                        color: #71717a;
                        font-size: 13px;
                    }
                }

                if !root.is_scanning: VerticalLayout {
                    spacing: 2px;
                    for line in root.lines: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: line.text;
                            color: line.color;
                            font-size: 13px;
                            font-weight: line.bold ? 600 : 400;
                        }
                    }
                }
            }
        }
    }
}
