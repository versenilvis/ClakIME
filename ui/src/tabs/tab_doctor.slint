import { Theme, DoctorLineData } from "../theme.slint";
import { Divider, SectionHeader } from "../components/controls.slint";
import { ActionButton, GhostButton } from "../components/buttons.slint";
import { ScrollView } from "std-widgets.slint";

// tab chan doan he thong phong cach terminal log
export component TabDoctor inherits VerticalLayout {
    in property <[DoctorLineData]> lines: [];
    in property <bool> has_scanned: false;
    in property <bool> is_scanning: false;
    in property <string> last_scanned: "";
    in property <string> summary_text: "";
    in property <bool> is_healthy: true;
    in property <bool> copied_toast: false;

    callback scan_requested();
    callback copy_requested();

    alignment: start;
    spacing: 12px;

    SectionHeader {
        title: "CHẨN ĐOÁN HỆ THỐNG";
        show-divider: false;
    }

    // thanh trang thai va cong cu tren dau tab
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            spacing: 3px;

            Text {
                text: "Kiểm tra toàn diện môi trường gõ phím";
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: Theme.feature-title-weight;
            }

            Text {
                text: root.has_scanned ? ("Lần quét gần nhất: " + root.last_scanned) : "Chưa thực hiện chẩn đoán trong phiên làm việc này";
                color: Theme.text-muted;
                font-size: 12px;
                font-weight: Theme.text-weight;
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 8px;

                if root.has_scanned: ActionButton {
                    text: root.copied_toast ? "Đã sao chép!" : "Sao chép báo cáo";
                    enabled: !root.is_scanning;
                    clicked => { root.copy_requested(); }
                }

                ActionButton {
                    text: root.is_scanning ? "Đang quét..." : (root.has_scanned ? "Quét lại" : "Chẩn đoán ngay");
                    primary: true;
                    enabled: !root.is_scanning;
                    clicked => { root.scan_requested(); }
                }
            }
        }
    }

    // noi dung chinh: man hinh trong (khi chua scan) hoac terminal console
    if !root.has_scanned && !root.is_scanning: Rectangle {
        height: 545px;
        background: #09090b;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: #18181b;

        VerticalLayout {
            alignment: center;
            spacing: 16px;

            Image {
                source: @image-url("../../assets/icons/activity.svg");
                width: 48px;
                height: 48px;
                colorize: #3f3f46;
                horizontal-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: "Sẵn sàng chẩn đoán hệ thống";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Tự động kiểm tra quyền /dev/uinput, thiết bị chuột, Fcitx5 RAM inode, file cấu hình và phát hiện ứng dụng xung đột.";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            HorizontalLayout {
                alignment: center;

                ActionButton {
                    text: "Bắt đầu chẩn đoán ngay";
                    primary: true;
                    clicked => { root.scan_requested(); }
                }
            }
        }
    }

    if root.has_scanned || root.is_scanning: Rectangle {
        height: 545px;
        background: #08080a;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: #1c1c21;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // thanh tieu de console gia lap terminal
            Rectangle {
                height: 36px;
                background: #0d0d11;
                border-top-left-radius: Theme.radius-md;
                border-top-right-radius: Theme.radius-md;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: parent.width;
                    background: #1a1a20;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: space-between;

                    // nut 3 cham mau phong cach terminal
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4.5px;
                                background: #ef4444;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4.5px;
                                background: #f59e0b;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4.5px;
                                background: #10b981;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "clak-doctor.log";
                            color: #71717a;
                            font-size: 12px;
                            font-weight: 500;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.is_scanning ? "● Đang quét..." : (root.is_healthy ? "● Khỏe mạnh" : "● Cần lưu ý");
                            color: root.is_scanning ? #60a5fa : (root.is_healthy ? #10b981 : #f59e0b);
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
            }

            // noi dung cac dong log co mau
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 14px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 4px;
                    alignment: start;

                    if root.is_scanning: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "> Đang truy vấn kernel và thông tin session...";
                            color: #60a5fa;
                            font-size: 13px;
                        }
                        Text {
                            text: "> Kiểm tra quyền hạn thiết bị /dev/uinput và /dev/input...";
                            color: #71717a;
                            font-size: 13px;
                        }
                        Text {
                            text: "> Phân tích bảng ánh xạ bộ nhớ /proc/*/maps của Fcitx5...";
                            color: #71717a;
                            font-size: 13px;
                        }
                    }

                    if !root.is_scanning: VerticalLayout {
                        spacing: 2px;
                        for line in root.lines: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: line.text;
                                color: line.color;
                                font-size: 13px;
                                font-weight: line.bold ? 600 : 400;
                            }
                        }
                    }
                }
            }
        }
    }
}
